# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# Optional: open Telegram media connections to these data centers at boot (comma list, e.g. "4,5").
# Default empty = open on first use; saves memory on small hosts, costs about a second on the first play per bot.
PREWARM_DCS=""
