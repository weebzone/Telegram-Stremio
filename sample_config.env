# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# Optional: data centers to open Telegram media connections to at boot (default "1,2,4,5").
# Fewer = less memory per bot; "none" = open on first play (saves RAM, costs about a second on the first play per bot).
# PREWARM_DCS="1,2,4,5"
